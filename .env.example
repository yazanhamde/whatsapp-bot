# ══════════════════════════════════════════
#   OpenAI
# ══════════════════════════════════════════
OPENAI_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_VERIFY_MODEL=gpt-4o
OPENAI_WHISPER=whisper-1

# ══════════════════════════════════════════
#   WhatsApp Cloud API
# ══════════════════════════════════════════
WA_PHONE_ID=your_phone_id
WA_TOKEN=your_whatsapp_token
WA_APP_SECRET=your_app_secret
WA_VERIFY_TOKEN=your_verify_token
WA_BOT_PHONE=your_bot_phone_number

# ══════════════════════════════════════════
#   Database
# ══════════════════════════════════════════
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4
CLEANUP_MEDIA_DAYS=7

# ══════════════════════════════════════════
#   Owner / Store
# ══════════════════════════════════════════
OWNER_PHONE=your_phone_number
OWNER_NAME=Your Name
STORE_NAME=Your Store Name
ACCOUNTING_OWNER_PHONE=your_accounting_phone

# ══════════════════════════════════════════
#   Security & Dashboard
# ══════════════════════════════════════════
OWNER_API_KEY=generate_a_strong_random_key

SMA_API_BASE=https://your-pos-system.com/api/v1/
SMA_API_KEY=your_sma_api_key
SYNC_SECRET_TOKEN=your_sync_token
